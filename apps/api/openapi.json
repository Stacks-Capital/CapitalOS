{
  "openapi": "3.1.0",
  "info": {
    "title": "Capital OS API",
    "version": "1.0"
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Server side API key, `key_<id>.<secret>`. Never sent from a browser."
      },
      "walletSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Wallet session token, `ses_<id>.<secret>`, from POST /v1/auth/verify."
      },
      "clientId": {
        "type": "apiKey",
        "in": "header",
        "name": "x-capital-client-id",
        "description": "Publishable client id. Accepted only with an Origin header the app allows."
      }
    },
    "schemas": {
      "MarketsResponse": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "network": {
            "type": "string",
            "enum": [
              "stacks:mainnet",
              "stacks:testnet"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Market"
                }
              },
              "nextCursor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "items",
              "nextCursor"
            ]
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          }
        },
        "required": [
          "schemaVersion",
          "requestId",
          "network",
          "data",
          "context"
        ]
      },
      "Market": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "network": {
            "type": "string",
            "enum": [
              "mainnet",
              "testnet"
            ],
            "description": "Required on every request. There is no default network."
          },
          "protocol": {
            "type": "string"
          },
          "suppliedAssetId": {
            "type": [
              "string",
              "null"
            ]
          },
          "receiptAssetId": {
            "type": [
              "string",
              "null"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Capability"
            }
          }
        },
        "required": [
          "id",
          "network",
          "protocol",
          "suppliedAssetId",
          "receiptAssetId",
          "capabilities"
        ]
      },
      "Capability": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "enabled",
              "read_only",
              "paused",
              "disabled"
            ]
          },
          "reason": {
            "type": "string"
          },
          "contractId": {
            "type": "string"
          },
          "deploymentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "adapterVersion": {
            "type": "string"
          },
          "registryVersion": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "state",
          "reason",
          "contractId",
          "deploymentId",
          "adapterVersion",
          "registryVersion"
        ]
      },
      "Context": {
        "type": "object",
        "properties": {
          "blockHeight": {
            "type": "integer",
            "minimum": 0
          },
          "blockHash": {
            "type": "string"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "observedAt",
          "stale",
          "warnings"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryAfter": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "requestId",
          "error"
        ]
      },
      "CapabilitiesResponse": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "network": {
            "type": "string",
            "enum": [
              "stacks:mainnet",
              "stacks:testnet"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MarketCapability"
                }
              },
              "nextCursor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "items",
              "nextCursor"
            ]
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          }
        },
        "required": [
          "schemaVersion",
          "requestId",
          "network",
          "data",
          "context"
        ]
      },
      "MarketCapability": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Capability"
          },
          {
            "type": "object",
            "properties": {
              "marketId": {
                "type": "string"
              }
            },
            "required": [
              "marketId"
            ]
          }
        ]
      },
      "ChallengeResponse": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "network": {
            "type": "string",
            "enum": [
              "stacks:mainnet",
              "stacks:testnet"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/Challenge"
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          }
        },
        "required": [
          "schemaVersion",
          "requestId",
          "network",
          "data",
          "context"
        ]
      },
      "Challenge": {
        "type": "object",
        "properties": {
          "nonceId": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "description": "Sign this exact text with the wallet's message signing request."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "nonceId",
          "message",
          "expiresAt"
        ]
      },
      "ChallengeRequest": {
        "type": "object",
        "properties": {
          "network": {
            "type": "string",
            "enum": [
              "mainnet",
              "testnet"
            ],
            "description": "Required on every request. There is no default network."
          },
          "address": {
            "type": "string",
            "maxLength": 64,
            "description": "Stacks address that will sign. It must belong to the network."
          }
        },
        "required": [
          "network",
          "address"
        ]
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "network": {
            "type": "string",
            "enum": [
              "stacks:mainnet",
              "stacks:testnet"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/Session"
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          }
        },
        "required": [
          "schemaVersion",
          "requestId",
          "network",
          "data",
          "context"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Bearer token for this wallet session. It is returned only once."
          },
          "sessionId": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "token",
          "sessionId",
          "address",
          "expiresAt"
        ]
      },
      "VerifyRequest": {
        "type": "object",
        "properties": {
          "network": {
            "type": "string",
            "enum": [
              "mainnet",
              "testnet"
            ],
            "description": "Required on every request. There is no default network."
          },
          "nonceId": {
            "type": "string",
            "pattern": "^non_[a-f0-9]{32}$"
          },
          "publicKey": {
            "type": "string",
            "pattern": "^[0-9a-f]{66}$"
          },
          "signature": {
            "type": "string",
            "pattern": "^[0-9a-f]{130}$"
          }
        },
        "required": [
          "network",
          "nonceId",
          "publicKey",
          "signature"
        ]
      },
      "WorkflowResponse": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "network": {
            "type": "string",
            "enum": [
              "stacks:mainnet",
              "stacks:testnet"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/Workflow"
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          }
        },
        "required": [
          "schemaVersion",
          "requestId",
          "network",
          "data",
          "context"
        ]
      },
      "Workflow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "network": {
            "type": "string",
            "enum": [
              "mainnet",
              "testnet"
            ],
            "description": "Required on every request. There is no default network."
          },
          "state": {
            "type": "string"
          },
          "nextAction": {
            "type": "string"
          },
          "quoteId": {
            "type": [
              "string",
              "null"
            ]
          },
          "planId": {
            "type": [
              "string",
              "null"
            ]
          },
          "ownerAddress": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sequence": {
                  "type": "integer"
                },
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "actor": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "sequence",
                "from",
                "to",
                "reason",
                "actor",
                "evidence",
                "at"
              ]
            }
          }
        },
        "required": [
          "id",
          "network",
          "state",
          "nextAction",
          "quoteId",
          "planId",
          "ownerAddress",
          "createdAt",
          "updatedAt",
          "transitions"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/markets": {
      "get": {
        "security": [
          {
            "apiKey": []
          },
          {
            "walletSession": []
          },
          {
            "clientId": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "mainnet",
                "testnet"
              ],
              "description": "Required on every request. There is no default network."
            },
            "required": true,
            "description": "Required on every request. There is no default network.",
            "name": "network",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Page size, 1 to 100."
            },
            "required": false,
            "description": "Page size, 1 to 100.",
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 512,
              "description": "Opaque cursor from the previous page's nextCursor."
            },
            "required": false,
            "description": "Opaque cursor from the previous page's nextCursor.",
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Markets with their capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or network mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Credentials do not allow this request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit reached. Retry after the number of seconds in retryAfter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
