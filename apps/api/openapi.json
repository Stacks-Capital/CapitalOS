{
  "openapi": "3.1.0",
  "info": {
    "title": "Capital OS API",
    "version": "1.0"
  },
  "components": {
    "schemas": {
      "MarketsResponse": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "network": {
            "type": "string",
            "enum": [
              "stacks:mainnet",
              "stacks:testnet"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Market"
                }
              },
              "nextCursor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "items",
              "nextCursor"
            ]
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          }
        },
        "required": [
          "schemaVersion",
          "requestId",
          "network",
          "data",
          "context"
        ]
      },
      "Market": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "network": {
            "type": "string",
            "enum": [
              "mainnet",
              "testnet"
            ],
            "description": "Required on every request. There is no default network."
          },
          "protocol": {
            "type": "string"
          },
          "suppliedAssetId": {
            "type": [
              "string",
              "null"
            ]
          },
          "receiptAssetId": {
            "type": [
              "string",
              "null"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Capability"
            }
          }
        },
        "required": [
          "id",
          "network",
          "protocol",
          "suppliedAssetId",
          "receiptAssetId",
          "capabilities"
        ]
      },
      "Capability": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "enabled",
              "read_only",
              "paused",
              "disabled"
            ]
          },
          "reason": {
            "type": "string"
          },
          "contractId": {
            "type": "string"
          },
          "deploymentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "adapterVersion": {
            "type": "string"
          },
          "registryVersion": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "state",
          "reason",
          "contractId",
          "deploymentId",
          "adapterVersion",
          "registryVersion"
        ]
      },
      "Context": {
        "type": "object",
        "properties": {
          "blockHeight": {
            "type": "integer",
            "minimum": 0
          },
          "blockHash": {
            "type": "string"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "stale": {
            "type": "boolean"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "observedAt",
          "stale",
          "warnings"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryAfter": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "requestId",
          "error"
        ]
      },
      "CapabilitiesResponse": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "network": {
            "type": "string",
            "enum": [
              "stacks:mainnet",
              "stacks:testnet"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MarketCapability"
                }
              },
              "nextCursor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "items",
              "nextCursor"
            ]
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          }
        },
        "required": [
          "schemaVersion",
          "requestId",
          "network",
          "data",
          "context"
        ]
      },
      "MarketCapability": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Capability"
          },
          {
            "type": "object",
            "properties": {
              "marketId": {
                "type": "string"
              }
            },
            "required": [
              "marketId"
            ]
          }
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/markets": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "mainnet",
                "testnet"
              ],
              "description": "Required on every request. There is no default network."
            },
            "required": true,
            "description": "Required on every request. There is no default network.",
            "name": "network",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Page size, 1 to 100."
            },
            "required": false,
            "description": "Page size, 1 to 100.",
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 512,
              "description": "Opaque cursor from the previous page's nextCursor."
            },
            "required": false,
            "description": "Opaque cursor from the previous page's nextCursor.",
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Markets with their capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "mainnet",
                "testnet"
              ],
              "description": "Required on every request. There is no default network."
            },
            "required": true,
            "description": "Required on every request. There is no default network.",
            "name": "network",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Page size, 1 to 100."
            },
            "required": false,
            "description": "Page size, 1 to 100.",
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 512,
              "description": "Opaque cursor from the previous page's nextCursor."
            },
            "required": false,
            "description": "Opaque cursor from the previous page's nextCursor.",
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Capabilities by market and action",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
