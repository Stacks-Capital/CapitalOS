# Copy to .env.local and fill in. .env.local is git ignored; never commit real keys.
# `pnpm services:up` passes .env.local to Docker Compose. Plain `docker compose` only reads a file named .env.

# Local services from compose.yaml. Change the ports if something else already uses them,
# for example a system PostgreSQL on 5432, and keep the URLs below in sync.
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_PASSWORD=capitalos_local
REDIS_PASSWORD=capitalos_local
DATABASE_URL=postgres://capitalos:capitalos_local@127.0.0.1:5432/capitalos
REDIS_URL=redis://:capitalos_local@127.0.0.1:6379

# Optional provider keys used by scripts/probes (server side only)
HIRO_API_KEY=
PYTH_API_KEY=

# Ingestion worker (I06). HIRO_API_KEY above raises the provider limits and stays server side.
WORKER_NETWORK=mainnet
WORKER_INTERVAL_MS=60000
